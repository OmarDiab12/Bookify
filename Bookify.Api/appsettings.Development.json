{
  "ConnectionStrings": {
    "Database": "Server=(localdb)\\MSSQLLocalDB;Database=BookifyDb;Trusted_Connection=True;MultipleActiveResultSets=true",
    "Cache": "localhost:6379"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
  },
  "Authentication": {
    "Audience": "account",
    "ValidIssuer": "http://localhost:8080/realms/Bookify",
    "MetadataUrl": "http://localhost:8080/realms/Bookify/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "Keycloak": {
    "BaseUrl": "http://localhost:8080",
    "AdminUrl": "http://localhost:8080/admin/realms/Bookify/",
    "TokenUrl": "http://localhost:8080/realms/Bookify/protocol/openid-connect/token",
    "AdminClientId": "bookify-admin-client",
    "AdminClientSecret": "R4lbntAuWnkBGQHXQTZsb22ANBIJTH6d",
    "AuthClientId": "bookify-auth-client",
    "AuthClientSecret": "OnSv0T9jxpD34pVMywXxpLIEAfYXxkLm"
  },
  "Outbox": {
    "IntervalInSeconds": 10,
    "BatchSize": 10
  }
}